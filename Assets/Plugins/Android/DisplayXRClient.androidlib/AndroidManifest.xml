<?xml version="1.0" encoding="utf-8"?>
<!--
    What an Android DisplayXR client needs in its manifest, merged into the Unity app's (from DisplayXR's
    cube_handle_vk_android template, displayxr-runtime test_apps/handle). Unity's OpenXR package already ships
    the Khronos loader (openxr_loader.aar); these entries let it find and reach the DisplayXR runtime.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.displayxrdemos.fourdvviewer.displayxrclient">

    <queries>
        <!-- Android 11+ package visibility: without these the loader finds no runtime and
             xrCreateInstance fails with XR_ERROR_RUNTIME_UNAVAILABLE (black screen). -->
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <provider
            android:authorities="org.khronos.openxr.runtime_broker"
            tools:replace="android:authorities" />
        <package android:name="org.freedesktop.monado.openxr_runtime.in_process" />
        <package android:name="org.freedesktop.monado.openxr_runtime.out_of_process" />
        <intent>
            <action android:name="org.freedesktop.monado.ipc.CONNECT" />
        </intent>
        <!-- The vendor display processor's loader looks these up from the client's process. -->
        <package android:name="com.leialoft.display.config" />
        <package android:name="com.leia.headtrackingservice" />
    </queries>

    <!-- Face tracking (front camera) and the AR view (rear camera). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- The runtime anchors the weave's interlace phase on the window's screen position; an OEM
             sandboxing of View.getLocationOnScreen would report (0,0). -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_SANDBOXING_VIEW_BOUNDS_APIS"
            android:value="false" />
    </application>
</manifest>
