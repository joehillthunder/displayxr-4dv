float3 IntToColorHash(uint i)
{
    uint state = i * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    uint result = (word >> 22u) ^ word;
    
    // Normalize to 0..1 range for RGB
    float r = float(result * 1u) * (1.0 / 4294967295.0);
    float g = float(result * 123u) * (1.0 / 4294967295.0); // Shift for G
    float b = float(result * 456u) * (1.0 / 4294967295.0); // Shift for B
    
    return float3(r, g, b);
}

uint PackColor(float4 color)
{
    color = saturate(color);
    
    uint r = (uint)(color.r * 255.0 + 0.5);
    uint g = (uint)(color.g * 255.0 + 0.5);
    uint b = (uint)(color.b * 255.0 + 0.5);
    uint a = (uint)(color.a * 255.0 + 0.5);
    
    // Layout: 0xAABBGGRR
    return r | (g << 8) | (b << 16) | (a << 24);
}


